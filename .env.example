# Copy to .env (git-ignored) and fill in only what you use.
# Lookup order: real environment variables > .env > Windows Credential Manager.
# .env is searched in: PERSONAL_AGENT_ENV_FILE, then ./.env, then %APPDATA%\personal-agent\.env

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Optional: email tools (use an app password, never your main password)
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_USER=
# EMAIL_PASSWORD=

# Optional: fixed token for the local API (otherwise generated and kept in Credential Manager).
# Must match between agent-core and agent-chat.
# PERSONAL_AGENT_TOKEN=

# Optional: Langfuse tracing (see docs/phase6.md). Base URL e.g. https://cloud.langfuse.com
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
