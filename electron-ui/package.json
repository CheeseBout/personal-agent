{
  "name": "personal-agent-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop UI for the personal-agent daemon (tray, chat, approvals, avatar, voice)",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e": "electron-vite build && vitest run --config vitest.e2e.config.ts",
    "dist": "node node_modules/electron/install.js && electron-vite build && electron-builder --win dir"
  },
  "dependencies": {
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "dompurify": "^3.4.17",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "markdown-it": "^15.0.3",
    "playwright-core": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "local.personal-agent.ui",
    "productName": "personal-agent",
    "executableName": "agent-ui",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  }
}
